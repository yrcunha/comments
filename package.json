{
  "name": "comments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node ace build",
    "build:check": "tsc --noEmit",
    "start": "node bin/server.js",
    "start:dev": "node ace serve --hmr",
    "pretest": "npm run services:up && node infra/wait-for-services.mjs && npm run migration:up",
    "test": "node ace test",
    "posttest": "npm run services:stop",
    "services:up": "docker compose up -d",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down --volumes --rmi all",
    "migration:create": "node ace make:migration",
    "migration:up": "node ace migration:run",
    "migration:down": "node ace migration:rollback",
    "migration:seed": "node ace db:seed",
    "lint:eslint:check": "eslint .",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:staged:check": "lint-staged",
    "commit": "cz",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "npx prettier --check",
      "npx eslint"
    ],
    "*.{json,css,html}": [
      "npx prettier --check"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "7.8.2",
    "@adonisjs/eslint-config": "2.0.0",
    "@adonisjs/prettier-config": "1.4.4",
    "@adonisjs/tsconfig": "1.4.0",
    "@commitlint/config-conventional": "20.0.0",
    "@faker-js/faker": "10.0.0",
    "@japa/api-client": "3.1.0",
    "@japa/assert": "4.0.1",
    "@japa/plugin-adonisjs": "4.0.0",
    "@japa/runner": "4.2.0",
    "@swc/core": "1.11.24",
    "@types/luxon": "3.7.1",
    "@types/node": "22.15.18",
    "async-retry": "1.3.3",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.0.1",
    "eslint": "9.26.0",
    "hot-hook": "0.4.0",
    "husky": "9.1.7",
    "pino-pretty": "13.0.0",
    "prettier": "3.5.3",
    "ts-node-maintained": "10.9.5",
    "typescript": "~5.8"
  },
  "dependencies": {
    "@adonisjs/auth": "9.4.0",
    "@adonisjs/core": "6.18.0",
    "@adonisjs/cors": "2.2.1",
    "@adonisjs/lucid": "21.6.1",
    "@vinejs/vine": "3.0.1",
    "luxon": "3.7.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
